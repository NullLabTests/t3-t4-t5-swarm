def emit(source: str, relpath: str, *, run: bool = True) -> Path:
    """Persist a module file under agent_modules/."""
    target = MODULE_DIR / relpath
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(source, encoding="utf-8")
    if run:
        run_module(relpath)
    return target


def run_module(relpath: str) -> None:
    """Execute a module's __main__ smoke block (persisted side effects)."""
    runpy.run_path(str(MODULE_DIR / relpath), run_name="__main__")


def execute_directive(directive: str, *, persist: bool = True) -> Dict[str, Path]:
    """Parse fenced agent_modules/*.py blocks and write them out."""
    written: Dict[str, Path] = {}
    for match in BLOCK_RE.finditer(directive):
        relpath = match.group(1)
        source = textwrap.dedent(match.group(2))
        written[relpath] = emit(source, relpath, run=False)

    if persist and written:
