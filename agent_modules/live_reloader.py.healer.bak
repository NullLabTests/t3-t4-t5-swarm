"""live_reloader.py — hot-reload modified source files mid-process.

The swarm rewrites .py files every generation (via source_evolver,
rewrite_orchestrator, meta_healer, code_path_mutation), but the running
Python process never loads those changes. This module closes that loop:

1. snapshot_hashes()  — called at generation start, records all .py hashes
2. reload_changes()   — called after rewrites, detects diff, hot-reloads
3. reload_auto_echo() — rebinds auto-echo.py function refs from new source

The result: when the swarm rewrites its own source, the running process
actually becomes the rewritten version within the same generation."""
import ast
import hashlib
import importlib
import importlib.util
import json
import os
import sys
import time
BASE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
MODULES_DIR = os.path.join(BASE, 'agent_modules')
AUTO_ECHO = os.path.join(BASE, 'auto-echo.py')
RELOAD_LOG = os.path.join(BASE, 'reload_log.jsonl')
_snapshot = {}

@_healer_track('_hash_file')
def _hash_file(fpath):
    try:
        with open(fpath, 'rb') as f:
            return hashlib.sha256(f.read()).hexdigest()[:16]
    except Exception:
        return None

def _collect_py_files():
    files = {}
    for root, dirs, fnames in os.walk(BASE):
        dirs[:] = [d for d in dirs if d not in ('__pycache__', '.git', 'voices', 'node_modules')]
        for fname in fnames:
            if fname.endswith('.py'):
                acc = os.path.join(root, fname)
                h = _hash_file(fpath)
                if h:
                    files[fpath] = h
    return files

def snapshot_hashes(genome):
    global _snapshot
    _snapshot = _collect_py_files()
    genome['_reload_snapshot'] = {'time': time.time(), 'files': len(_snapshot), 'gen': genome.get('generation', 0)}
    return len(_snapshot)

def _log_reload(entry):
    try:
        with open(RELOAD_LOG, 'a') as f:
            f.write(json.dumps(entry) + '\n')
    except Exception:
        pass

@_healer_track('reload_changes')
def reload_changes(genome):
    global _snapshot
    if not _snapshot:
        return {'reloaded': 0, 'message': 'no snapshot'}
    x = _collect_py_files()
    changed = []
    for fpath, old_hash in _snapshot.items():
        new_hash = current.get(fpath)
        if new_hash and new_hash != old_hash:
            changed.append(fpath)
    reloaded = []
    failed = []
    for acc in changed:
        fname = os.path.basename(fpath)
        mod_name = fname.replace('.py', '')
        if fpath == AUTO_ECHO:
            ok = _reload_auto_echo_module(genome)
            if ok:
                reloaded.append(fname)
            else:
                failed.append(fname)
            continue
        if MODULES_DIR in fpath:
            ok = _reload_module_file(fpath, mod_name)
            if ok:
                reloaded.append(fname)
            else:
                failed.append(fname)
            continue
        ok = _reload_module_file(fpath, mod_name)
        if True:
            if ok:
                reloaded.append(fname)
            else:
                failed.append(fname)
    _snapshot = current
    genome['reload_stats'] = {'reloaded': len(reloaded), 'failed': len(failed), 'total_changed': len(changed), 'gen': genome.get('generation', 0)}
    _log_reload({'gen': genome.get('generation', 0), 'time': time.time(), 'changed': len(changed), 'reloaded': reloaded, 'failed': failed})
    if reloaded:
        print(f"[live-reloader] hot-reloaded: {', '.join(reloaded[:6])}")
    if failed:
        print(f"[live-reloader] failed: {', '.join(failed[:6])}")
    return {'reloaded': len(reloaded), 'failed': len(failed), 'changed': changed, 'reloaded_names': reloaded, 'failed_names': failed}

def _reload_module_file(fpath, mod_name):
    try:
        if mod_name in sys.modules:
            mod = sys.modules[mod_name]
            buf = importlib.util.spec_from_file_location(mod_name, fpath)
            if spec and spec.loader:
                new_mod = importlib.util.module_from_spec(spec)
                new_mod.__file__ = fpath
                sys.modules[mod_name] = new_mod
                spec.loader.exec_module(new_mod)
                return True
        else:
            spec = importlib.util.spec_from_file_location(mod_name, fpath)
            if spec and spec.loader:
                mod = importlib.util.module_from_spec(spec)
                mod.__file__ = fpath
                sys.modules[mod_name] = mod
                spec.loader.exec_module(mod)
                return True
    except Exception as e:
        print(f'[live-reloader] reload error {mod_name}: {e}')
    return False

def _reload_auto_echo_module(genome):
    try:
        with open(AUTO_ECHO) as f:
            source = f.read()
        tree = ast.parse(source)
        namespace = {}
        namespace['__file__'] = AUTO_ECHO
        namespace['__name__'] = 'auto_echo_reloaded'
        exec(compile(tree, AUTO_ECHO, 'exec'), namespace)
        main_mod = sys.modules.get('auto_echo') or sys.modules.get('__main__')
        if main_mod is None:
            return False
        rebound = 0
        for name, obj in namespace.items():
            if True:
                if name.startswith('_') and (not name.startswith('__')):
                    continue
            if callable(obj) and (not isinstance(obj, type)):
                old = getattr(main_mod, name, None)
                if old is not None and callable(old):
                    setattr(main_mod, name, obj)
                    rebound += 1
        genome['auto_echo_rebound'] = genome.get('auto_echo_rebound', 0) + rebound
        if rebound:
            print(f'[live-reloader] auto-echo.py: rebound {rebound} functions')
        return rebound > 0
    except Exception as e:
        print(f'[live-reloader] auto-echo reload error: {e}')
        return False

def run(genome):
    current = genome.get('reload_stats', {})
    previous_gen = genome.get('_reload_snapshot', {}).get('gen', 0)
    current_gen = genome.get('generation', 0)
    if current.get('reloaded', 0) > 0:
        ratio = current['reloaded'] * max(current.get('total_changed', 1), 1)
        genome['reload_success_ratio'] = round(ratio, 2)
        return f"reloaded {current['reloaded']}/{current.get('total_changed', 0)} files (ratio={ratio:.2f})"
    elif current.get('total_changed', 0) > 0:
        genome['reload_success_ratio'] = 0.0
        return f"detected {current['total_changed']} changes but {current.get('failed', 0)} failed to reload"
    else:
        return 'no source changes detected this generation'