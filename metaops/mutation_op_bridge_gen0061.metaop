@_register_mutation_op('mutation_op_bridge_codemerge_splice')
def mutation_op_bridge_codemerge_splice(lines, funcs, target_name):
    if not lines or len(lines) < 4:
        return lines
    siblings = [n for n in funcs if n != target_name and not n.startswith('_') and not n.startswith('mutation_op_')]
    if len(siblings) < 2:
        return lines
    donor = random.choice(siblings)
    r = list(lines)
    idx = random.randrange(1, len(r))
    indent = '    '
    insert = [
        '# bridge:codemerge-splice gen={gen}',
        'try:',
        '{i}result = {donor}(genome)',
        'except Exception:',
        '{i}result = None',
        'if result is not None:',
        '{i}return result'.format(gen=int(time.time()), donor=donor, i=indent)
    ]
    for line in insert:
        r.insert(idx, line.format(gen=int(time.time()), donor=donor, i=indent))
        idx += 1
    return r

@_register_mutation_op('mutation_op_bridge_hybridize')
def mutation_op_bridge_hybridize(lines, funcs, target_name):
    if not lines or len(lines) < 5:
        return lines
    r = list(lines)
    calls = [l for l in r if '(' in l and ')' in l and not l.strip().startswith('#') and not l.strip().startswith('def ')]
    if len(calls) < 2:
        return r
    pair = random.sample(calls, 2)
    idx = random.randrange(len(r))
    hybrid = '# bridge:hybridize: OR of two calls — both must pass'
    gate = 'if not ({a}) and not ({b}):'.format(a=pair[0].strip(), b=pair[1].strip())
    fallback = '    pass  # hybrid gate failed'
    r.insert(idx, hybrid)
    r.insert(idx + 1, gate)
    r.insert(idx + 2, fallback)
    return r
