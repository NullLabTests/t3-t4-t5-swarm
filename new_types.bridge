{
  ".genloop": {
    "handler": "_bridge_handler_genloop",
    "description": "Rewrite the generation loop structure: reorder phases, inject new phases, or remove stalled ones"
  },
  ".mutreflect": {
    "handler": "_bridge_handler_mutreflect",
    "description": "Reflect on mutation effectiveness and prune underperforming operators from the genome"
  },
  ".metaop": {
    "handler": "_bridge_handler_metaop",
    "description": "Register a mutation operator directly from a .metaop file"
  },
  ".srcmutate": {
    "handler": "_handler_srcmutate",
    "description": "Directly mutate agent module source code with AST-level transforms"
  }
}
